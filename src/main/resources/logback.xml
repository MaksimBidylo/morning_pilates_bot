<configuration>
    <conversionRule conversionWord="safeMessage" class="morningpilates.logging.SafeMessageConverter"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level [%thread] %logger{36} - %safeMessage%n%nopex</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>

    <logger name="morningpilates" level="${LOG_LEVEL:-INFO}"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
