<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <!-- Dependency exception/HTTP/SQL logs are not safe even at ERROR. -->
    <logger name="org.jooq" level="OFF"/>
    <logger name="org.postgresql" level="OFF"/>
    <logger name="com.zaxxer.hikari" level="OFF"/>
    <logger name="org.flywaydb" level="OFF"/>
    <logger name="okhttp3" level="OFF"/>
    <logger name="retrofit2" level="OFF"/>
    <logger name="com.github.kotlintelegrambot" level="OFF"/>
    <logger name="morningpilates.diagnostics" level="${TELEGRAM_LOG_LEVEL:-INFO}"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
